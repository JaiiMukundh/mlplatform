        }
      }
    }
  },
  "autoscaling_v2__HorizontalPodAutoscaler__serving__model-api": {
    "apiVersion": "autoscaling/v2",
    "kind": "HorizontalPodAutoscaler",
    "metadata": {
      "labels": {
        "app.kubernetes.io/instance": "model-api",
        "app.kubernetes.io/name": "model-api",
        "app.kubernetes.io/version": "${TAG}"
      },
      "name": "model-api",
      "namespace": "serving"
    },
    "spec": {
      "behavior": {
        "scaleDown": {
          "stabilizationWindowSeconds": 60
        }
      },
      "maxReplicas": 6,
      "metrics": [
        {
          "resource": {
            "name": "cpu",
            "target": {
              "averageUtilization": 60,
              "type": "Utilization"
            }
          },
          "type": "Resource"
        }
      ],
      "minReplicas": 2,
      "scaleTargetRef": {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "name": "model-api"
      }
    }
  },
  "autoscaling_v2__HorizontalPodAutoscaler__staging__model-api-staging": {
    "apiVersion": "autoscaling/v2",
    "kind": "HorizontalPodAutoscaler",
    "metadata": {
      "labels": {
        "app.kubernetes.io/instance": "model-api-staging",
        "app.kubernetes.io/name": "model-api",
        "app.kubernetes.io/version": "${TAG}"
      },
      "name": "model-api-staging",
      "namespace": "staging"
    },
    "spec": {
      "behavior": {
        "scaleDown": {
          "stabilizationWindowSeconds": 60
        }
      },
      "maxReplicas": 6,
      "metrics": [
        {
          "resource": {
            "name": "cpu",
            "target": {
              "averageUtilization": 60,
              "type": "Utilization"
            }
          },
          "type": "Resource"
        }
      ],
      "minReplicas": 2,
      "scaleTargetRef": {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "name": "model-api-staging"
      }
    }
  },
