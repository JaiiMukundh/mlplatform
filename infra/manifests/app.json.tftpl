    "apiVersion": "v1",
    "data": {
      "pod-spec.json": "{\n  \"restartPolicy\": \"OnFailure\",\n  \"serviceAccountName\": \"retrain\",\n  \"containers\": [\n    {\n      \"name\": \"retrain\",\n      \"image\": \"${ACR}/mlp-retrain:${TAG}\",\n      \"imagePullPolicy\": \"Always\",\n      \"resources\": {\n        \"limits\": {\n          \"cpu\": \"1900m\",\n          \"memory\": \"3Gi\"\n        },\n        \"requests\": {\n          \"cpu\": \"500m\",\n          \"memory\": \"1Gi\"\n        }\n      },\n      \"env\": [\n        {\n          \"name\": \"MLFLOW_TRACKING_URI\",\n          \"value\": \"http://mlflow.data.svc:5000\"\n        },\n        {\n          \"name\": \"FEAST_S3_ENDPOINT_URL\",\n          \"value\": \"http://minio.data.svc:9000\"\n        },\n        {\n          \"name\": \"TRIGGER\",\n          \"value\": \"drift\"\n        },\n        {\n          \"name\": \"TRIGGER_MODE\",\n          \"value\": \"in_cluster\"\n        },\n        {\n          \"name\": \"PUBLIC_IP_NAME\",\n          \"value\": \"${PUBLIC_IP_NAME}\"\n        },\n        {\n          \"name\": \"AZURE_RESOURCE_GROUP\",\n          \"value\": \"${RESOURCE_GROUP}\"\n        },\n        {\n          \"name\": \"AZURE_ALLOWED_CIDR\",\n          \"value\": \"${ALLOWED_CIDR}\"\n        },\n        {\n          \"name\": \"DEPLOY_TARGET\",\n          \"value\": \"azure\"\n        },\n        {\n          \"name\": \"MODEL_API_REPOSITORY\",\n          \"value\": \"${ACR}/mlp-model-api\"\n        },\n        {\n          \"name\": \"TRAINING_IMAGE\",\n          \"value\": \"${ACR}/mlp-training:${TAG}\"\n        },\n        {\n          \"name\": \"IMAGE_TAG\",\n          \"value\": \"${TAG}\"\n        },\n        {\n          \"name\": \"STAGING_URL\",\n          \"value\": \"http://model-api-staging.staging.svc:8080\"\n        },\n        {\n          \"name\": \"PROD_URL\",\n          \"value\": \"http://model-api.serving.svc:8080\"\n        },\n        {\n          \"name\": \"STAGING_SMOKE_URL\",\n          \"value\": \"http://model-api-staging.staging.svc:8080\"\n        },\n        {\n          \"name\": \"PROD_SMOKE_URL\",\n          \"value\": \"http://model-api.serving.svc:8080\"\n        },\n        {\n          \"name\": \"AWS_EC2_METADATA_DISABLED\",\n          \"value\": \"true\"\n        },\n        {\n          \"name\": \"MPLCONFIGDIR\",\n          \"value\": \"/tmp\"\n        },\n        {\n          \"name\": \"HOME\",\n          \"value\": \"/tmp\"\n        },\n        {\n          \"name\": \"LOADCHECK_TOTAL\",\n          \"value\": \"300\"\n        },\n        {\n          \"name\": \"LOADCHECK_RPS\",\n          \"value\": \"30\"\n        },\n        {\n          \"name\": \"GATE_REPORT_OUT\",\n          \"value\": \"/tmp/gate_report.json\"\n        },\n        {\n          \"name\": \"GATE_REPORT\",\n          \"value\": \"/tmp/gate_report.json\"\n        },\n        {\n          \"name\": \"POSTGRES_USER\",\n          \"valueFrom\": {\n            \"secretKeyRef\": {\n              \"name\": \"postgres-auth\",\n              \"key\": \"username\"\n            }\n          }\n        },\n        {\n          \"name\": \"POSTGRES_PASSWORD\",\n          \"valueFrom\": {\n            \"secretKeyRef\": {\n              \"name\": \"postgres-auth\",\n              \"key\": \"postgres-password\"\n            }\n          }\n        },\n        {\n          \"name\": \"POSTGRES_HOST\",\n          \"value\": \"postgres.data.svc\"\n        },\n        {\n          \"name\": \"POSTGRES_PORT\",\n          \"value\": \"5432\"\n        },\n        {\n          \"name\": \"FEAST_POSTGRES_DB\",\n          \"value\": \"feast\"\n        },\n        {\n          \"name\": \"REDIS_HOST\",\n          \"value\": \"redis.data.svc\"\n        },\n        {\n          \"name\": \"REDIS_PORT\",\n          \"value\": \"6379\"\n        },\n        {\n          \"name\": \"AWS_ACCESS_KEY_ID\",\n          \"valueFrom\": {\n            \"secretKeyRef\": {\n              \"name\": \"minio-auth\",\n              \"key\": \"root-user\"\n            }\n          }\n        },\n        {\n          \"name\": \"AWS_SECRET_ACCESS_KEY\",\n          \"valueFrom\": {\n            \"secretKeyRef\": {\n              \"name\": \"minio-auth\",\n              \"key\": \"root-password\"\n            }\n          }\n        },\n        {\n          \"name\": \"MODEL_API_TOKEN\",\n          \"valueFrom\": {\n            \"secretKeyRef\": {\n              \"name\": \"model-api-token\",\n              \"key\": \"token\"\n            }\n          }\n        }\n      ],\n      \"command\": [\n        \"/bin/bash\",\n        \"-c\"\n      ],\n      \"args\": [\n        \"set -Eeuo pipefail\\n# Use the pod ServiceAccount token for Kubernetes API calls.\\ncat > /tmp/kubeconfig <<KUBECONFIG\\napiVersion: v1\\nkind: Config\\nclusters:\\n- name: in-cluster\\n  cluster:\\n    server: https://$${KUBERNETES_SERVICE_HOST}:$${KUBERNETES_SERVICE_PORT_HTTPS}\\n    certificate-authority: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt\\nusers:\\n- name: retrain\\n  user:\\n    token: $(cat /var/run/secrets/kubernetes.io/serviceaccount/token)\\ncontexts:\\n- name: in-cluster\\n  context:\\n    cluster: in-cluster\\n    user: retrain\\ncurrent-context: in-cluster\\nKUBECONFIG\\nexport KUBECONFIG=/tmp/kubeconfig\\ncd /app\\npython -m feature_repo.render_config\\npython -m retrain.main\\n\"\n      ]\n    }\n  ]\n}"
    },
    "kind": "ConfigMap",
    "metadata": {
      "name": "retrain-job-template",
      "namespace": "data"
    }
  },
  "v1__ServiceAccount__data__retrain": {
    "apiVersion": "v1",
    "kind": "ServiceAccount",
    "metadata": {
      "name": "retrain",
      "namespace": "data"
    }
  },
  "v1__ServiceAccount__observability__dashboard": {
    "apiVersion": "v1",
    "kind": "ServiceAccount",
    "metadata": {
      "name": "dashboard",
      "namespace": "observability"
    }
  },
  "v1__ServiceAccount__observability__drift-monitor": {
    "apiVersion": "v1",
    "kind": "ServiceAccount",
    "metadata": {
      "name": "drift-monitor",
      "namespace": "observability"
    }
  },
  "v1__ServiceAccount__observability__remediator": {
    "apiVersion": "v1",
    "kind": "ServiceAccount",
    "metadata": {
      "name": "remediator",
      "namespace": "observability"
    }
  },
  "v1__Service__observability__dashboard": {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "annotations": {
        "service.beta.kubernetes.io/azure-load-balancer-resource-group": "${RESOURCE_GROUP}",
        "service.beta.kubernetes.io/azure-pip-name": "${PUBLIC_IP_NAME}"
      },
      "name": "dashboard",
      "namespace": "observability"
    },
    "spec": {
      "externalTrafficPolicy": "Local",
      "loadBalancerSourceRanges": [
        "${ALLOWED_CIDR}",
        "${RUNNER_CIDR}"
      ],
      "ports": [
        {
          "name": "https",
          "port": 443,
          "targetPort": "https"
        }
      ],
      "selector": {
        "app": "dashboard"
      },
      "type": "LoadBalancer"
    }
  },
  "v1__Service__observability__drift-monitor": {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "labels": {
        "app.kubernetes.io/name": "drift-monitor"
      },
      "name": "drift-monitor",
      "namespace": "observability"
    },
    "spec": {
      "ports": [
        {
          "name": "http",
          "port": 8080,
          "targetPort": "http"
        }
      ],
      "selector": {
        "app.kubernetes.io/name": "drift-monitor"
      },
      "type": "ClusterIP"
    }
  },
  "v1__Service__observability__remediator": {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "labels": {
        "app.kubernetes.io/name": "remediator"
      },
      "name": "remediator",
      "namespace": "observability"
    },
    "spec": {
      "ports": [
        {
          "name": "http",
          "port": 8080,
          "targetPort": "http"
        }
      ],
      "selector": {
        "app.kubernetes.io/name": "remediator"
      },
      "type": "ClusterIP"
    }
  },
  "v1__Service__serving__model-api": {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "annotations": {
        "service.beta.kubernetes.io/azure-load-balancer-resource-group": "${RESOURCE_GROUP}",
        "service.beta.kubernetes.io/azure-pip-name": "${PUBLIC_IP_NAME}"
      },
      "labels": {
        "app.kubernetes.io/instance": "model-api",
        "app.kubernetes.io/name": "model-api",
        "app.kubernetes.io/version": "${TAG}"
      },
      "name": "model-api",
      "namespace": "serving"
    },
    "spec": {
      "externalTrafficPolicy": "Local",
      "loadBalancerSourceRanges": [
        "${ALLOWED_CIDR}",
        "${RUNNER_CIDR}"
      ],
      "ports": [
        {
          "name": "http",
          "nodePort": 30080,
          "port": 8080,
          "targetPort": "http"
        }
      ],
      "selector": {
        "app.kubernetes.io/instance": "model-api",
        "app.kubernetes.io/name": "model-api"
      },
      "type": "LoadBalancer"
    }
  },
  "v1__Service__staging__model-api-staging": {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "labels": {
        "app.kubernetes.io/instance": "model-api-staging",
        "app.kubernetes.io/name": "model-api",
        "app.kubernetes.io/version": "${TAG}"
      },
      "name": "model-api-staging",
      "namespace": "staging"
    },
    "spec": {
      "ports": [
        {
          "name": "http",
          "port": 8080,
          "targetPort": "http"
