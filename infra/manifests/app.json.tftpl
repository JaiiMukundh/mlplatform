  "networking.k8s.io_v1__NetworkPolicy__serving__model-api": {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "NetworkPolicy",
    "metadata": {
      "labels": {
        "app.kubernetes.io/instance": "model-api",
        "app.kubernetes.io/name": "model-api",
        "app.kubernetes.io/version": "${TAG}"
      },
      "name": "model-api",
      "namespace": "serving"
    },
    "spec": {
      "egress": [
        {
          "ports": [
            {
              "port": 53,
              "protocol": "UDP"
            },
            {
              "port": 53,
              "protocol": "TCP"
            }
          ],
          "to": [
            {
              "namespaceSelector": {}
            }
          ]
        },
        {
          "ports": [
            {
              "port": 6379,
              "protocol": "TCP"
            },
            {
              "port": 5432,
              "protocol": "TCP"
            },
            {
              "port": 5000,
              "protocol": "TCP"
            },
            {
              "port": 9000,
              "protocol": "TCP"
            }
          ],
          "to": [
            {
              "namespaceSelector": {
                "matchLabels": {
                  "kubernetes.io/metadata.name": "data"
                }
              }
            }
          ]
        }
      ],
      "ingress": [
        {
          "from": [
            {
              "namespaceSelector": {
                "matchLabels": {
                  "kubernetes.io/metadata.name": "observability"
                }
              }
            },
            {
              "namespaceSelector": {
                "matchLabels": {
                  "kubernetes.io/metadata.name": "data"
                }
              }
            },
            {
              "namespaceSelector": {
                "matchLabels": {
                  "kubernetes.io/metadata.name": "serving"
                }
              }
            },
            {
              "ipBlock": {
                "cidr": "${ALLOWED_CIDR}"
              }
            },
            {
              "ipBlock": {
                "cidr": "${RUNNER_CIDR}"
              }
            }
          ],
          "ports": [
            {
              "port": 8080,
              "protocol": "TCP"
            }
          ]
        }
      ],
      "podSelector": {
        "matchLabels": {
          "app.kubernetes.io/instance": "model-api",
          "app.kubernetes.io/name": "model-api"
        }
      },
      "policyTypes": [
        "Ingress",
        "Egress"
      ]
    }
  },
