{
  "networking.k8s.io_v1__NetworkPolicy__observability__platform-ingress": {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "NetworkPolicy",
    "metadata": {
      "name": "platform-ingress",
      "namespace": "observability"
    },
    "spec": {
      "podSelector": {},
      "policyTypes": [
        "Ingress"
      ],
      "ingress": [
        {
          "from": [
            {
              "namespaceSelector": {
                "matchLabels": {
                  "kubernetes.io/metadata.name": "observability"
                }
              }
            }
          ]
        },
        {
          "from": [
            {
              "ipBlock": {
                "cidr": "${ALLOWED_CIDR}"
              }
            },
            {
              "ipBlock": {
                "cidr": "${RUNNER_CIDR}"
              }
            }
          ],
          "ports": [
            {
              "protocol": "TCP",
              "port": 8050
            }
          ]
        }
      ]
    }
  },
  "apps_v1__Deployment__observability__dashboard": {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "dashboard",
      "namespace": "observability"
    },
    "spec": {
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app": "dashboard"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "dashboard"
          }
        },
        "spec": {
          "containers": [
            {
              "env": [
                {
                  "name": "DEPLOY_TARGET",
                  "value": "azure"
                },
                {
                  "name": "PYTHONPATH",
                  "value": "/app"
                },
                {
                  "name": "CLUSTER_NAME",
                  "value": "${CLUSTER_NAME}"
                },
                {
                  "name": "PUBLIC_IP_NAME",
                  "value": "${PUBLIC_IP_NAME}"
                },
                {
                  "name": "AZURE_RESOURCE_GROUP",
                  "value": "${RESOURCE_GROUP}"
                },
                {
                  "name": "AZURE_ALLOWED_CIDR",
                  "value": "${ALLOWED_CIDR}"
                },
                {
                  "name": "IMAGE_TAG",
                  "value": "${IMAGE_TAG}"
                },
                {
                  "name": "TRAINING_IMAGE",
                  "value": "${TRAINING_IMAGE}"
                },
                {
                  "name": "MODEL_API_REPOSITORY",
                  "value": "${MODEL_API_REPOSITORY}"
                },
                {
                  "name": "MODEL_API_URL",
                  "value": "http://model-api.serving.svc:8080"
                },
                {
                  "name": "SMOKE_BASE_URL",
                  "value": "http://model-api.serving.svc:8080"
                },
                {
                  "name": "PROMETHEUS_URL",
                  "value": "http://kube-prometheus-stack-prometheus.observability.svc:9090"
                },
                {
                  "name": "MLFLOW_TRACKING_URI",
                  "value": "http://mlflow.data.svc:5000"
                },
                {
                  "name": "MINIO_ENDPOINT",
                  "value": "http://minio.data.svc:9000"
                },
                {
                  "name": "MLFLOW_S3_ENDPOINT_URL",
                  "value": "http://minio.data.svc:9000"
                },
                {
                  "name": "AWS_DEFAULT_REGION",
                  "value": "us-east-1"
                },
                {
                  "name": "PUBLIC_HOST",
                  "value": "${PUBLIC_HOST}"
                },
                {
                  "name": "DASHBOARD_PASSWORD",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "admin-password",
                      "name": "grafana-admin"
                    }
                  }
                },
                {
                  "name": "AWS_ACCESS_KEY_ID",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "access-key",
                      "name": "dashboard-data"
                    }
                  }
                },
                {
                  "name": "AWS_SECRET_ACCESS_KEY",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "secret-key",
                      "name": "dashboard-data"
                    }
                  }
                },
                {
                  "name": "MODEL_API_TOKEN",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "model-api-token",
                      "key": "token"
                    }
                  }
                }
              ],
              "image": "${DASHBOARD_IMAGE}",
              "livenessProbe": {
                "httpGet": {
                  "path": "/healthz",
                  "port": "https",
                  "scheme": "HTTPS"
                },
                "periodSeconds": 20
              },
              "name": "dashboard",
              "ports": [
                {
                  "containerPort": 8050,
                  "name": "https"
                }
              ],
              "readinessProbe": {
                "httpGet": {
                  "path": "/healthz",
                  "port": "https",
                  "scheme": "HTTPS"
                }
              },
              "resources": {
                "limits": {
                  "cpu": "1000m",
                  "memory": "2Gi"
                },
                "requests": {
                  "cpu": "100m",
                  "memory": "512Mi"
                }
              },
              "startupProbe": {
                "failureThreshold": 120,
                "httpGet": {
                  "path": "/healthz",
                  "port": "https",
                  "scheme": "HTTPS"
                },
                "periodSeconds": 5
              },
              "volumeMounts": [
                {
                  "mountPath": "/app/tls",
                  "name": "tls",
                  "readOnly": true
                },
                {
                  "mountPath": "/app/data",
                  "name": "data"
                },
                {
                  "mountPath": "/app/artifacts",
                  "name": "artifacts"
                }
              ]
            }
          ],
          "securityContext": {
            "fsGroup": 10001,
            "runAsNonRoot": true,
            "runAsUser": 10001
          },
          "serviceAccountName": "dashboard",
          "volumes": [
            {
              "name": "tls",
              "secret": {
                "secretName": "dashboard-tls"
              }
            },
            {
              "emptyDir": {},
              "name": "data"
            },
            {
              "emptyDir": {},
              "name": "artifacts"
            }
          ]
        }
      }
    }
  },
  "apps_v1__Deployment__observability__drift-monitor": {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "labels": {
        "app.kubernetes.io/name": "drift-monitor"
      },
      "name": "drift-monitor",
      "namespace": "observability"
    },
    "spec": {
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/name": "drift-monitor"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/name": "drift-monitor"
          }
        },
        "spec": {
          "containers": [
            {
              "env": [
                {
                  "name": "DATABASE_URL",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "database-url",
                      "name": "drift-monitor-db"
                    }
                  }
                },
                {
                  "name": "MLFLOW_TRACKING_URI",
                  "value": "http://mlflow.data.svc:5000"
                },
                {
                  "name": "DRIFT_INTERVAL_SECONDS",
                  "value": "10"
                },
                {
                  "name": "DRIFT_WINDOW_SIZE",
                  "value": "1000"
                },
                {
                  "name": "DRIFT_MIN_SAMPLES",
                  "value": "100"
                },
                {
                  "name": "DRIFT_PSI_THRESHOLD",
                  "value": "0.25"
                },
                {
                  "name": "DRIFT_KS_D_THRESHOLD",
                  "value": "0.2"
                },
                {
                  "name": "DRIFT_KS_P",
                  "value": "0.01"
                },
                {
                  "name": "DRIFT_MIN_FEATURES",
                  "value": "2"
                },
                {
                  "name": "DRIFT_CONSECUTIVE",
                  "value": "2"
                },
                {
                  "name": "RETRAIN_COOLDOWN_SECONDS",
                  "value": "30"
                },
                {
                  "name": "LOG_LEVEL",
                  "value": "INFO"
                }
              ],
              "image": "${ACR}/mlp-drift-monitor:${TAG}",
              "imagePullPolicy": "Always",
              "livenessProbe": {
                "httpGet": {
                  "path": "/healthz",
                  "port": "http"
                }
              },
              "name": "drift-monitor",
              "ports": [
                {
                  "containerPort": 8080,
                  "name": "http"
                }
              ],
              "readinessProbe": {
                "httpGet": {
                  "path": "/healthz",
                  "port": "http"
                }
              },
              "resources": {
                "limits": {
                  "cpu": "1",
                  "memory": "1Gi"
                },
                "requests": {
                  "cpu": "200m",
                  "memory": "512Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true,
                "runAsNonRoot": true,
                "runAsUser": 10001
              },
              "startupProbe": {
                "failureThreshold": 12,
                "httpGet": {
                  "path": "/healthz",
                  "port": "http"
                },
                "periodSeconds": 5
              },
              "volumeMounts": [
                {
                  "mountPath": "/tmp",
                  "name": "tmp"
                }
              ]
            }
          ],
          "securityContext": {
            "fsGroup": 10001,
            "runAsGroup": 10001,
            "runAsNonRoot": true,
            "runAsUser": 10001,
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "serviceAccountName": "drift-monitor",
          "volumes": [
            {
              "emptyDir": {},
              "name": "tmp"
            }
          ]
        }
      }
    }
  },
  "apps_v1__Deployment__observability__remediator": {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "labels": {
        "app.kubernetes.io/name": "remediator"
      },
      "name": "remediator",
      "namespace": "observability"
    },
    "spec": {
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/name": "remediator"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/name": "remediator"
          }
        },
        "spec": {
          "containers": [
            {
              "env": [
                {
                  "name": "GRAFANA_URL",
                  "value": "http://kube-prometheus-stack-grafana.observability.svc:80"
                },
                {
                  "name": "GRAFANA_USER",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "admin-user",
                      "name": "grafana-admin"
                    }
                  }
                },
                {
                  "name": "GRAFANA_PASSWORD",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "admin-password",
                      "name": "grafana-admin"
                    }
                  }
                }
              ],
              "image": "${ACR}/mlp-remediator:${TAG}",
              "imagePullPolicy": "IfNotPresent",
              "livenessProbe": {
                "httpGet": {
                  "path": "/healthz",
                  "port": "http"
                }
              },
              "name": "remediator",
              "ports": [
                {
                  "containerPort": 8080,
                  "name": "http"
                }
              ],
              "readinessProbe": {
                "httpGet": {
                  "path": "/readyz",
                  "port": "http"
                }
              },
              "resources": {
                "limits": {
                  "cpu": "250m",
                  "memory": "256Mi"
                },
                "requests": {
                  "cpu": "50m",
                  "memory": "128Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true,
                "runAsNonRoot": true,
                "runAsUser": 10001
              },
              "startupProbe": {
                "failureThreshold": 12,
                "httpGet": {
                  "path": "/healthz",
                  "port": "http"
                },
                "periodSeconds": 5
              },
              "volumeMounts": [
                {
                  "mountPath": "/tmp",
                  "name": "tmp"
                }
              ]
            }
          ],
          "securityContext": {
            "fsGroup": 10001,
            "runAsGroup": 10001,
            "runAsNonRoot": true,
            "runAsUser": 10001,
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "serviceAccountName": "remediator",
          "volumes": [
            {
              "emptyDir": {},
              "name": "tmp"
            }
          ]
        }
      }
    }
  },
  "apps_v1__Deployment__serving__model-api": {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "labels": {
        "app.kubernetes.io/instance": "model-api",
        "app.kubernetes.io/name": "model-api",
        "app.kubernetes.io/version": "${TAG}"
      },
      "name": "model-api",
      "namespace": "serving"
    },
    "spec": {
      "replicas": 2,
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/instance": "model-api",
          "app.kubernetes.io/name": "model-api"
        }
      },
      "strategy": {
        "rollingUpdate": {
          "maxSurge": 1,
          "maxUnavailable": 0
        },
        "type": "RollingUpdate"
      },
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/instance": "model-api",
            "app.kubernetes.io/name": "model-api"
          }
        },
        "spec": {
          "affinity": {
            "podAntiAffinity": {
              "preferredDuringSchedulingIgnoredDuringExecution": [
                {
                  "podAffinityTerm": {
                    "labelSelector": {
                      "matchExpressions": [
                        {
                          "key": "app.kubernetes.io/name",
                          "operator": "In",
                          "values": [
                            "model-api"
                          ]
                        }
                      ]
                    },
                    "topologyKey": "kubernetes.io/hostname"
                  },
                  "weight": 100
                }
              ]
            }
          },
          "containers": [
            {
              "env": [
                {
                  "name": "MODEL_NAME",
                  "value": "loan-default"
                },
                {
                  "name": "MODEL_VERSION",
                  "value": "${VERSION}"
                },
                {
                  "name": "MODEL_SOURCE",
                  "value": "mlflow"
                },
                {
                  "name": "FEATURE_SOURCE",
                  "value": "feast"
                },
                {
                  "name": "FEATURE_SERVICE",
                  "value": "loan_default_v1"
                },
                {
                  "name": "MLFLOW_TRACKING_URI",
                  "value": "http://mlflow.data.svc:5000"
                },
                {
                  "name": "REDIS_URL",
                  "value": "redis://redis.data.svc:6379/0"
                },
                {
                  "name": "LOG_LEVEL",
                  "value": "INFO"
                },
                {
                  "name": "ENABLE_CHAOS",
                  "value": "true"
                },
                {
                  "name": "DATABASE_URL",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "database-url",
                      "name": "postgres-app"
                    }
                  }
                },
                {
                  "name": "MODEL_API_TOKEN",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "model-api-token",
                      "key": "token"
                    }
                  }
                }
              ],
              "image": "${ACR}/mlp-model-api:${TAG}",
              "imagePullPolicy": "Always",
              "livenessProbe": {
                "httpGet": {
                  "path": "/healthz",
                  "port": "http"
                }
              },
              "name": "api",
              "ports": [
                {
                  "containerPort": 8080,
                  "name": "http"
                }
              ],
              "readinessProbe": {
                "httpGet": {
                  "path": "/readyz",
                  "port": "http"
                }
              },
              "resources": {
                "limits": {
                  "cpu": "1",
                  "memory": "1Gi"
                },
                "requests": {
                  "cpu": "250m",
                  "memory": "512Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true,
                "runAsNonRoot": true,
                "runAsUser": 10001
              },
              "startupProbe": {
                "failureThreshold": 30,
                "httpGet": {
                  "path": "/healthz",
                  "port": "http"
                },
                "periodSeconds": 2
              },
              "volumeMounts": [
                {
                  "mountPath": "/tmp",
                  "name": "tmp"
                }
              ]
            }
          ],
          "securityContext": {
            "fsGroup": 10001,
            "runAsGroup": 10001,
            "runAsNonRoot": true,
            "runAsUser": 10001,
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "topologySpreadConstraints": [
            {
              "labelSelector": {
                "matchLabels": {
                  "app.kubernetes.io/instance": "model-api",
                  "app.kubernetes.io/name": "model-api"
                }
              },
              "maxSkew": 1,
              "topologyKey": "kubernetes.io/hostname",
              "whenUnsatisfiable": "ScheduleAnyway"
            }
          ],
          "volumes": [
            {
              "emptyDir": {},
              "name": "tmp"
            }
          ]
        }
      }
    }
  },
  "apps_v1__Deployment__staging__model-api-staging": {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "labels": {
