  "v1__ConfigMap__observability__kube-prometheus-stack-grafana": {
    "apiVersion": "v1",
    "data": {
      "grafana.ini": "[analytics]\ncheck_for_updates = true\n[log]\nmode = console\n[paths]\ndata = /var/lib/grafana/\nlogs = /var/log/grafana\nplugins = /var/lib/grafana/plugins\nprovisioning = /etc/grafana/provisioning\n[plugins]\npreinstall_auto_update = false\n[server]\ndomain = ''\n[unified_storage]\nindex_path = /var/lib/grafana-search/bleve\n"
    },
    "kind": "ConfigMap",
    "metadata": {
      "labels": {
        "app.kubernetes.io/instance": "kube-prometheus-stack",
        "app.kubernetes.io/name": "grafana",
        "app.kubernetes.io/version": "13.2.3"
      },
      "name": "kube-prometheus-stack-grafana",
      "namespace": "observability"
    }
  },
  "v1__ConfigMap__observability__kube-prometheus-stack-grafana-config-dashboards": {
    "apiVersion": "v1",
    "data": {
      "provider.yaml": "apiVersion: 1\nproviders:\n  - name: 'sidecarProvider'\n    orgId: 1\n    folder: ''\n    folderUid: ''\n    type: file\n    disableDeletion: false\n    allowUiUpdates: false\n    updateIntervalSeconds: 30\n    options:\n      foldersFromFilesStructure: false\n      path: /tmp/dashboards"
    },
    "kind": "ConfigMap",
    "metadata": {
      "labels": {
        "app.kubernetes.io/instance": "kube-prometheus-stack",
        "app.kubernetes.io/name": "grafana",
        "app.kubernetes.io/version": "13.2.3"
      },
      "name": "kube-prometheus-stack-grafana-config-dashboards",
      "namespace": "observability"
    }
  },
  "v1__ConfigMap__observability__kube-prometheus-stack-grafana-datasource": {
    "apiVersion": "v1",
    "data": {
      "datasource.yaml": "apiVersion: 1\ndatasources:\n- name: \"Prometheus\"\n  type: prometheus\n  uid: prometheus\n  url: http://kube-prometheus-stack-prometheus.observability:9090/\n  access: proxy\n  isDefault: true\n  jsonData:\n    httpMethod: POST\n    timeInterval: 30s\n- name: \"Alertmanager\"\n  type: alertmanager\n  uid: alertmanager\n  url: http://kube-prometheus-stack-alertmanager.observability:9093/\n  access: proxy\n  jsonData:\n    handleGrafanaManagedAlerts: false\n    implementation: prometheus\n- access: proxy\n  editable: false\n  name: Loki\n  type: loki\n  uid: loki\n  url: http://loki.observability.svc:3100"
    },
    "kind": "ConfigMap",
    "metadata": {
      "labels": {
        "app": "kube-prometheus-stack-grafana",
        "app.kubernetes.io/instance": "kube-prometheus-stack",
        "app.kubernetes.io/part-of": "kube-prometheus-stack",
        "app.kubernetes.io/version": "91.8.2",
        "chart": "kube-prometheus-stack-91.8.2",
        "grafana_datasource": "1",
        "release": "kube-prometheus-stack"
      },
      "name": "kube-prometheus-stack-grafana-datasource",
      "namespace": "observability"
    }
  },
  "v1__ConfigMap__observability__kube-prometheus-stack-grafana-test": {
    "apiVersion": "v1",
    "data": {
      "run.sh": "@test \"Test Health\" {\n  url=\"http://kube-prometheus-stack-grafana/api/health\"\n\n  code=$(wget --server-response --spider --timeout 90 --tries 10 $${url} 2>&1 | awk '/^  HTTP/{print $2}')\n  [ \"$code\" == \"200\" ]\n}"
    },
    "kind": "ConfigMap",
    "metadata": {
      "labels": {
        "app.kubernetes.io/instance": "kube-prometheus-stack",
        "app.kubernetes.io/name": "grafana",
        "app.kubernetes.io/version": "13.2.3"
      },
      "name": "kube-prometheus-stack-grafana-test",
      "namespace": "observability"
    }
  },
