      "namespace": "observability"
    },
    "spec": {
      "endpoints": [
        {
          "authorization": {
            "credentials": {
              "key": "token",
              "name": "kube-prometheus-stack-prometheus-token"
            },
            "type": "Bearer"
          },
          "port": "http-metrics",
          "scheme": "https",
          "tlsConfig": {
            "ca": {
              "configMap": {
                "key": "ca.crt",
                "name": "kube-root-ca.crt"
              }
            },
            "insecureSkipVerify": true
          },
          "relabelings": [
            {
              "targetLabel": "cluster",
              "replacement": "${CLUSTER_NAME}"
            }
          ]
        }
      ],
      "jobLabel": "jobLabel",
      "namespaceSelector": {
        "matchNames": [
          "kube-system"
        ]
      },
      "selector": {
        "matchLabels": {
          "app": "kube-prometheus-stack-kube-scheduler",
          "release": "kube-prometheus-stack"
        }
      }
    }
  },
