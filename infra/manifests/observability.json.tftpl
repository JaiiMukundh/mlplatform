              "name": "memcached",
              "ports": [
                {
                  "containerPort": 11211,
                  "name": "client"
                }
              ],
              "readinessProbe": {
                "failureThreshold": 6,
                "initialDelaySeconds": 5,
                "periodSeconds": 5,
                "tcpSocket": {
                  "port": "client"
                },
                "timeoutSeconds": 3
              },
              "resources": {
                "limits": {
                  "memory": "128Mi"
                },
                "requests": {
                  "cpu": "500m",
                  "memory": "96Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true
              }
            },
            {
              "args": [
                "--memcached.address=localhost:11211",
                "--web.listen-address=0.0.0.0:9150"
              ],
              "image": "prom/memcached-exporter:v0.15.4",
              "imagePullPolicy": "IfNotPresent",
              "livenessProbe": {
                "failureThreshold": 3,
                "httpGet": {
                  "path": "/metrics",
                  "port": "http-metrics"
                },
                "initialDelaySeconds": 30,
                "periodSeconds": 10,
                "timeoutSeconds": 5
              },
              "name": "exporter",
              "ports": [
                {
                  "containerPort": 9150,
                  "name": "http-metrics"
                }
              ],
              "readinessProbe": {
                "failureThreshold": 3,
                "httpGet": {
                  "path": "/metrics",
                  "port": "http-metrics"
                },
                "initialDelaySeconds": 5,
                "periodSeconds": 5,
                "timeoutSeconds": 3
              },
              "resources": {
                "limits": {},
                "requests": {}
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true
              }
            }
          ],
          "initContainers": [],
          "nodeSelector": {},
          "securityContext": {
            "fsGroup": 11211,
            "runAsGroup": 11211,
            "runAsNonRoot": true,
            "runAsUser": 11211
          },
          "serviceAccountName": "loki",
          "terminationGracePeriodSeconds": 60,
          "tolerations": [],
          "topologySpreadConstraints": []
        }
      },
      "updateStrategy": {
        "type": "RollingUpdate"
      }
    }
  },
  "batch_v1__Job__observability__kube-prometheus-stack-admission-create": {
    "apiVersion": "batch/v1",
    "kind": "Job",
    "metadata": {
      "labels": {
        "app": "kube-prometheus-stack-admission-create",
        "app.kubernetes.io/component": "prometheus-operator-webhook",
        "app.kubernetes.io/instance": "kube-prometheus-stack",
        "app.kubernetes.io/name": "kube-prometheus-stack-prometheus-operator",
        "app.kubernetes.io/part-of": "kube-prometheus-stack",
        "app.kubernetes.io/version": "91.8.2",
        "chart": "kube-prometheus-stack-91.8.2",
        "release": "kube-prometheus-stack"
      },
      "name": "kube-prometheus-stack-admission-create",
      "namespace": "observability"
    },
    "spec": {
      "template": {
        "metadata": {
          "labels": {
            "app": "kube-prometheus-stack-admission-create",
            "app.kubernetes.io/component": "prometheus-operator-webhook",
            "app.kubernetes.io/instance": "kube-prometheus-stack",
            "app.kubernetes.io/name": "kube-prometheus-stack-prometheus-operator",
            "app.kubernetes.io/part-of": "kube-prometheus-stack",
            "app.kubernetes.io/version": "91.8.2",
            "chart": "kube-prometheus-stack-91.8.2",
            "release": "kube-prometheus-stack"
          },
          "name": "kube-prometheus-stack-admission-create"
        },
        "spec": {
          "containers": [
            {
              "args": [
                "create",
                "--host=kube-prometheus-stack-operator,kube-prometheus-stack-operator.observability.svc",
                "--namespace=observability",
                "--secret-name=kube-prometheus-stack-admission"
              ],
              "image": "ghcr.io/jkroepke/kube-webhook-certgen:1.8.9",
              "imagePullPolicy": "IfNotPresent",
              "name": "create",
              "resources": {},
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true
              }
            }
          ],
          "restartPolicy": "OnFailure",
          "securityContext": {
            "runAsGroup": 2000,
            "runAsNonRoot": true,
            "runAsUser": 2000,
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "serviceAccountName": "kube-prometheus-stack-admission"
        }
      },
      "ttlSecondsAfterFinished": 60
    }
  },
