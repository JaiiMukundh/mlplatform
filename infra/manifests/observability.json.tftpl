  "v1__Service__observability__kube-prometheus-stack-alertmanager": {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "annotations": {
        "service.beta.kubernetes.io/azure-load-balancer-resource-group": "${RESOURCE_GROUP}",
        "service.beta.kubernetes.io/azure-pip-name": "${PUBLIC_IP_NAME}"
      },
      "labels": {
        "app": "kube-prometheus-stack-alertmanager",
        "app.kubernetes.io/instance": "kube-prometheus-stack",
        "app.kubernetes.io/part-of": "kube-prometheus-stack",
        "app.kubernetes.io/version": "91.8.2",
        "chart": "kube-prometheus-stack-91.8.2",
        "release": "kube-prometheus-stack",
        "self-monitor": "true"
      },
      "name": "kube-prometheus-stack-alertmanager",
      "namespace": "observability"
    },
    "spec": {
      "externalTrafficPolicy": "Cluster",
      "loadBalancerSourceRanges": [
        "${ALLOWED_CIDR}",
        "${RUNNER_CIDR}"
      ],
      "ports": [
        {
          "name": "http-web",
          "nodePort": 30093,
          "port": 9093,
          "protocol": "TCP",
          "targetPort": 9093
        }
      ],
      "selector": {
        "alertmanager": "kube-prometheus-stack-alertmanager",
        "app.kubernetes.io/name": "alertmanager"
      },
      "sessionAffinity": "None",
      "type": "LoadBalancer"
    }
  },
  "v1__Service__observability__kube-prometheus-stack-grafana": {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "annotations": {
        "service.beta.kubernetes.io/azure-load-balancer-resource-group": "${RESOURCE_GROUP}",
        "service.beta.kubernetes.io/azure-pip-name": "${PUBLIC_IP_NAME}"
      },
      "labels": {
        "app.kubernetes.io/instance": "kube-prometheus-stack",
        "app.kubernetes.io/name": "grafana",
        "app.kubernetes.io/version": "13.2.3"
      },
      "name": "kube-prometheus-stack-grafana",
      "namespace": "observability"
    },
    "spec": {
      "loadBalancerSourceRanges": [
        "${ALLOWED_CIDR}",
        "${RUNNER_CIDR}"
      ],
      "ports": [
        {
          "name": "http-web",
          "nodePort": 30030,
          "port": 3000,
          "protocol": "TCP",
          "targetPort": "grafana"
        }
      ],
      "selector": {
        "app.kubernetes.io/instance": "kube-prometheus-stack",
        "app.kubernetes.io/name": "grafana"
      },
      "type": "LoadBalancer"
    }
  },
